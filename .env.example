# ═══════════════════════════════════════════════════════════════
# RelayPay — Environment Configuration
# Copy this file to .env and fill in your real values
# ═══════════════════════════════════════════════════════════════

# ─── Deployment & Wallet ─────────────────────────────────────
# Your Flare Coston2 testnet private key (DO NOT commit to git)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ─── Flare Network ──────────────────────────────────────────
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Flare system contract addresses (Coston2 Testnet)
FDC_VERIFICATION_ADDRESS=0x1000000000000000000000000000000000000003
FTSO_V2_ADDRESS=0x3d893C53D9e8056135C26C8c638B76C8b60Df726

# FTSO v2 Feed ID for XRP/USD (category=0x01 + "XRP/USD" padded)
XRP_USD_FEED_ID=0x01585250000000000000000000000000000000000000

# ─── Deployed Contract ───────────────────────────────────────
# Set this AFTER running the deploy script
REGISTRY_ADDRESS=0xYOUR_DEPLOYED_REGISTRY_ADDRESS

# ─── XRPL Network ───────────────────────────────────────────
XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233

# ─── FDC Verifier API ───────────────────────────────────────
FDC_API_URL=https://fdc-verifiers-coston2.flare.network

# ─── FDC Relayer Daemon ─────────────────────────────────────
# Private key for the relayer to auto-submit fulfillment transactions
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY_HERE
# Comma-separated XRPL addresses to monitor for payments
MONITORED_XRPL_ACCOUNTS=rYOUR_MERCHANT_XRPL_ADDRESS

# ─── Frontend Dashboard ─────────────────────────────────────
VITE_REGISTRY_ADDRESS=0xYOUR_DEPLOYED_REGISTRY_ADDRESS
VITE_FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
VITE_FDC_API_URL=https://fdc-verifiers-coston2.flare.network
VITE_XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233
