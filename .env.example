# RelayPay Smart Contracts Environment Configuration

# EVM Private Key for Deployment (Requires testnet CFLR for gas)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Flare Network EVM RPC Endpoints
FLARE_COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
FLARE_MAINNET_RPC=https://flare-api.flare.network/ext/C/rpc

# Official Flare System Contracts (Coston2 Defaults)
FDC_VERIFICATION_ADDRESS=0x1000000000000000000000000000000000000001
FTSO_V2_ADDRESS=0x1000000000000000000000000000000000000002

# Flare FTSO v2 Feed ID for XRP/USD (Category 0x01 + "XRP/USD")
XRP_USD_FEED_ID=0x014152502f55534400000000000000000000000000
